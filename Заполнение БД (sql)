CREATE OR REPLACE FUNCTION log_grades_changes() RETURNS TRIGGER LANGUAGE plpgsql AS $$
BEGIN
    IF (TG_OP = 'INSERT') THEN
        INSERT INTO audit_logs (user_name, table_name, record_id, action_type, new_data)
        VALUES (current_user, TG_TABLE_NAME, NEW.id, 'INSERT', row_to_json(NEW));
        RETURN NEW;
    ELSIF (TG_OP = 'UPDATE') THEN
        INSERT INTO audit_logs (user_name, table_name, record_id, action_type, old_data, new_data)
        VALUES (current_user, TG_TABLE_NAME, NEW.id, 'UPDATE', row_to_json(OLD), row_to_json(NEW));
        RETURN NEW;
    ELSIF (TG_OP = 'DELETE') THEN
        INSERT INTO audit_logs (user_name, table_name, record_id, action_type, old_data)
        VALUES (current_user, TG_TABLE_NAME, OLD.id, 'DELETE', row_to_json(OLD));
        RETURN OLD;
    END IF;
    RETURN NULL;
END; $$;
DROP TRIGGER IF EXISTS grades_audit_trigger ON grades;
CREATE TRIGGER grades_audit_trigger AFTER INSERT OR UPDATE OR DELETE ON grades FOR EACH ROW EXECUTE FUNCTION log_grades_changes();

CREATE OR REPLACE FUNCTION log_schedule_changes() RETURNS TRIGGER LANGUAGE plpgsql AS $$
BEGIN
    IF (TG_OP = 'INSERT') THEN
        INSERT INTO audit_logs (user_name, table_name, record_id, action_type, new_data)
        VALUES (current_user, TG_TABLE_NAME, NEW.id, 'INSERT', row_to_json(NEW));
        RETURN NEW;
    ELSIF (TG_OP = 'UPDATE') THEN
        INSERT INTO audit_logs (user_name, table_name, record_id, action_type, old_data, new_data)
        VALUES (current_user, TG_TABLE_NAME, NEW.id, 'UPDATE', row_to_json(OLD), row_to_json(NEW));
        RETURN NEW;
    ELSIF (TG_OP = 'DELETE') THEN
        INSERT INTO audit_logs (user_name, table_name, record_id, action_type, old_data)
        VALUES (current_user, TG_TABLE_NAME, OLD.id, 'DELETE', row_to_json(OLD));
        RETURN OLD;
    END IF;
    RETURN NULL;
END; $$;
DROP TRIGGER IF EXISTS schedule_audit_trigger ON schedule;
CREATE TRIGGER schedule_audit_trigger AFTER INSERT OR UPDATE OR DELETE ON schedule FOR EACH ROW EXECUTE FUNCTION log_schedule_changes();

CREATE OR REPLACE FUNCTION check_schedule_conflict() RETURNS TRIGGER LANGUAGE plpgsql AS $$
BEGIN
    IF EXISTS (SELECT 1 FROM schedule s WHERE s.id != COALESCE(NEW.id, -1)
        AND s.classroom_id = NEW.classroom_id AND s.week_type = NEW.week_type
        AND s.start_time < NEW.end_time AND s.end_time > NEW.start_time) THEN
        RAISE EXCEPTION 'Конфликт расписания: аудитория уже занята в это время';
    END IF;
    RETURN NEW;
END; $$;
DROP TRIGGER IF EXISTS schedule_conflict_trigger ON schedule;
CREATE TRIGGER schedule_conflict_trigger BEFORE INSERT OR UPDATE ON schedule FOR EACH ROW EXECUTE FUNCTION check_schedule_conflict();

