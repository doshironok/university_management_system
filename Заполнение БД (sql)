CREATE OR REPLACE PROCEDURE add_grade(
    p_student_id INT, p_study_plan_id INT, p_grade VARCHAR, p_exam_date DATE, p_type VARCHAR
) LANGUAGE plpgsql AS $$
BEGIN
    INSERT INTO grades (student_id, study_plan_id, grade, exam_date, type)
    VALUES (p_student_id, p_study_plan_id, p_grade, p_exam_date, p_type);
END; $$;

CREATE OR REPLACE FUNCTION get_student_gpa(p_student_id INT) RETURNS NUMERIC LANGUAGE plpgsql AS $$
DECLARE result NUMERIC;
BEGIN
    SELECT AVG(CAST(grade AS NUMERIC)) INTO result
    FROM grades WHERE student_id = p_student_id AND type = 'экзамен' AND grade ~ '^[0-5]$';
    RETURN COALESCE(result, 0);
END; $$;

CREATE OR REPLACE FUNCTION get_teacher_workload(p_teacher_id INT) RETURNS INT LANGUAGE plpgsql AS $$
DECLARE total_hours INT;
BEGIN
    SELECT COALESCE(SUM(EXTRACT(HOUR FROM (s.end_time - s.start_time)) *
           CASE WHEN s.week_type = 'каждую' THEN 1 ELSE 0.5 END), 0)
    INTO total_hours FROM schedule s WHERE s.teacher_id = p_teacher_id;
    RETURN total_hours;
END; $$;

CREATE OR REPLACE FUNCTION generate_grades_report(p_group_id INT, p_discipline_id INT)
RETURNS TABLE (student_fio VARCHAR, grade VARCHAR, exam_date DATE) LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
    SELECT s.fio, g.grade, g.exam_date
    FROM grades g JOIN students s ON g.student_id = s.id
    JOIN study_plans sp ON g.study_plan_id = sp.id
    WHERE sp.group_id = p_group_id AND sp.discipline_id = p_discipline_id ORDER BY s.fio;
END; $$;

CREATE OR REPLACE PROCEDURE backup_database() LANGUAGE plpgsql AS $$
BEGIN
    INSERT INTO audit_logs (user_name, action_type, table_name)
    VALUES (current_user, 'REQUESTED DATABASE BACKUP', 'ALL');
END; $$;

CREATE OR REPLACE PROCEDURE add_schedule_entry(
    p_discipline_id INT, p_classroom_id INT, p_teacher_id INT, p_group_id INT,
    p_start_time TIME, p_end_time TIME, p_week_type VARCHAR
) LANGUAGE plpgsql AS $$
BEGIN
    INSERT INTO schedule (discipline_id, classroom_id, teacher_id, group_id, start_time, end_time, week_type)
    VALUES (p_discipline_id, p_classroom_id, p_teacher_id, p_group_id, p_start_time, p_end_time, p_week_type);
END; $$;

CREATE OR REPLACE FUNCTION get_group_schedule(p_group_id INT)
RETURNS TABLE (discipline_name VARCHAR, teacher_fio VARCHAR, classroom_number VARCHAR, start_time TIME, end_time TIME, week_type VARCHAR) LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
    SELECT d.name, t.fio, c.number, s.start_time, s.end_time, s.week_type
    FROM schedule s JOIN disciplines d ON s.discipline_id = d.id
    LEFT JOIN teachers t ON s.teacher_id = t.id JOIN classrooms c ON s.classroom_id = c.id
    WHERE s.group_id = p_group_id ORDER BY s.start_time;
END; $$;

CREATE OR REPLACE FUNCTION get_teacher_schedule(p_teacher_id INT)
RETURNS TABLE (discipline_name VARCHAR, group_name VARCHAR, classroom_number VARCHAR, start_time TIME, end_time TIME, week_type VARCHAR) LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
    SELECT d.name, g.name, c.number, s.start_time, s.end_time, s.week_type
    FROM schedule s JOIN disciplines d ON s.discipline_id = d.id
    JOIN groups g ON s.group_id = g.id JOIN classrooms c ON s.classroom_id = c.id
    WHERE s.teacher_id = p_teacher_id ORDER BY s.start_time;
END; $$;

CREATE OR REPLACE FUNCTION check_classroom_availability(p_classroom_id INT, p_start_time TIME, p_end_time TIME, p_week_type VARCHAR) RETURNS BOOLEAN LANGUAGE plpgsql AS $$
DECLARE is_available BOOLEAN;
BEGIN
    SELECT NOT EXISTS (SELECT 1 FROM schedule s WHERE s.classroom_id = p_classroom_id
        AND s.week_type = p_week_type AND s.start_time < p_end_time AND s.end_time > p_start_time)
    INTO is_available;
    RETURN is_available;
END; $$;

CREATE OR REPLACE FUNCTION generate_classroom_occupancy_report()
RETURNS TABLE (classroom_number VARCHAR, building VARCHAR, total_hours_per_week INT) LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
    SELECT c.number, c.building,
           SUM(EXTRACT(HOUR FROM (s.end_time - s.start_time)) *
           CASE WHEN s.week_type = 'каждую' THEN 1 ELSE 0.5 END)::INT
    FROM schedule s JOIN classrooms c ON s.classroom_id = c.id
    GROUP BY c.number, c.building ORDER BY total_hours_per_week DESC;
END; $$;

CREATE OR REPLACE FUNCTION get_student_rating(p_group_id INT)
RETURNS TABLE (student_id INT, student_fio VARCHAR, avg_grade NUMERIC, "position" INT) LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
    WITH ranked_students AS (
        SELECT s.id, s.fio, get_student_gpa(s.id) as avg_grade,
               RANK() OVER (ORDER BY get_student_gpa(s.id) DESC) as "position"
        FROM students s WHERE s.group_id = p_group_id AND s.status = true
    )
    SELECT id, fio, avg_grade, "position"::INT FROM ranked_students ORDER BY "position";
END; $$;

